{
  "version": 2,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TOKSHIT_BUILD_TESTS": "ON",
        "TOKSHIT_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOKSHIT_BUILD_TESTS": "ON",
        "TOKSHIT_BUILD_TOOLS": "ON"
      }
    }
  ]
}
